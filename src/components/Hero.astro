---
import Poster from './Poster.astro';
import Wordmark from './Wordmark.astro';
import { reel, site } from '../lib/films';
const first = reel[0];
---

<section class="hero" aria-labelledby="hero-title" data-reel={reel.map((f) => f.slug).join(',')}>
  <div class="frame">
    <div class="weave">
      <div class="posters" aria-hidden="true">
        {
          reel.map((f, i) => (
            <Poster
              film={f}
              class={i === 0 ? 'poster is-on' : 'poster'}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
          ))
        }
      </div>
      <div class="players" aria-hidden="true">
        <div class="player"><div id="reel-a"></div></div>
        <div class="player"><div id="reel-b"></div></div>
      </div>
    </div>
    <div class="shade" aria-hidden="true"></div>
    <div class="leak" aria-hidden="true"></div>
    <div class="flash" aria-hidden="true"></div>

    <div class="titlecard">
      <Wordmark as="h1" id="hero-title" class="hero-wm" />
      <p class="byline">Films by {site.name}</p>
    </div>

    <p class="subtitle"><span>Every shot is a memory I don’t want to forget.</span></p>
  </div>

  <div class="slate">
    <p class="now" aria-live="polite">
      <span class="now-label">Now showing</span>
      <span class="now-title"
        ><span data-now-title lang={first.language ?? undefined}>{first.title}</span><span data-now-year>, {first.year}</span></span
      >
    </p>
    <div class="slate-actions">
      <button class="btn" type="button" data-now-watch data-slug={first.slug} data-cursor="play">
        <svg viewBox="0 0 10 12" aria-hidden="true"><path d="M0 0l10 6-10 6z" fill="currentColor"></path></svg>
        Watch this film
      </button>
      <button class="round" type="button" data-reel-toggle aria-pressed="false">
        <span class="visually-hidden">Pause the trailer</span>
        <svg class="i-pause" viewBox="0 0 10 12" aria-hidden="true"><path d="M1 0h3v12H1zM6 0h3v12H6z" fill="currentColor"></path></svg>
        <svg class="i-play" viewBox="0 0 10 12" aria-hidden="true"><path d="M0 0l10 6-10 6z" fill="currentColor"></path></svg>
      </button>
      <span class="tc" data-tc aria-hidden="true">00:00:00:00</span>
    </div>
  </div>

  <a class="scroll-cue" href="#story">
    <span>Scroll to begin</span>
    <span class="cue-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    --bar-top: 3.5rem;
    --bar-bottom: 7.5rem;
    position: relative;
    height: 100svh;
    min-height: 36rem;
    background: var(--black);
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .hero {
      /* Letterbox to 2.39:1 when the window is wide enough */
      --scope: max(3.5rem, calc((100svh - 100vw / 2.39) / 2));
      --bar-top: max(3.5rem, var(--scope));
      --bar-bottom: max(6.5rem, var(--scope));
    }
  }

  .frame {
    position: absolute;
    inset: var(--bar-top) 0 var(--bar-bottom);
    container-type: size;
    overflow: hidden;
  }
  /* Gate weave: the picture breathes a pixel, like film running through a gate */
  .weave {
    position: absolute;
    inset: -4px;
    animation: weave 0.4s steps(2) infinite;
  }
  @keyframes weave {
    0% { transform: translate(0, 0); }
    25% { transform: translate(0.6px, -0.5px); }
    50% { transform: translate(-0.4px, 0.7px); }
    75% { transform: translate(0.5px, 0.3px); }
  }

  .posters :global(.poster) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 1.2s ease,
      transform 9s linear;
  }
  .posters :global(.poster.is-on) {
    opacity: 1;
    transform: scale(1);
  }

  .players {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .player {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100cqw, 177.78cqh);
    height: max(100cqh, 56.25cqw);
    transform: translate(-50%, -50%) scale(1.04);
    opacity: 0;
  }
  .player.is-on {
    opacity: 1;
  }
  .player :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 50% 45%, transparent 40%, rgb(0 0 0 / 0.65) 100%),
      linear-gradient(to top, rgb(0 0 0 / 0.55), transparent 40%);
  }
  /* Light leaks drifting across the frame, the way old stock fogs at the edges */
  .leak {
    position: absolute;
    inset: -20%;
    mix-blend-mode: screen;
    opacity: 0.38;
    background:
      radial-gradient(35% 45% at 12% 30%, rgb(255 120 40 / 0.55), transparent 70%),
      radial-gradient(30% 40% at 88% 75%, rgb(255 60 90 / 0.35), transparent 70%);
    animation: leak 14s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes leak {
    0% { transform: translate(-6%, 2%) rotate(0deg); opacity: 0.22; }
    50% { opacity: 0.45; }
    100% { transform: translate(6%, -3%) rotate(8deg); opacity: 0.28; }
  }
  /* A burst of light on every cut */
  .flash {
    position: absolute;
    inset: 0;
    background: radial-gradient(80% 80% at 30% 40%, rgb(255 214 160 / 0.9), rgb(255 140 60 / 0.4) 50%, transparent 80%);
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
  }
  .flash.is-on {
    animation: flash 0.55s ease-out;
  }
  @keyframes flash {
    0% { opacity: 0.85; }
    100% { opacity: 0; }
  }

  .titlecard {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: clamp(0.8rem, 2.4cqh, 1.6rem);
    text-align: center;
    pointer-events: none;
  }
  .titlecard :global(.hero-wm) {
    font-size: clamp(2.4rem, 12vw, 11.5rem);
    font-weight: 480;
    letter-spacing: 0;
    gap: 0.08em;
    text-shadow: 0 6px 40px rgb(0 0 0 / 0.45);
  }
  .titlecard :global(.hero-wm .wm-l),
  .titlecard :global(.hero-wm .wm-o) {
    opacity: 0;
    transform: translateY(0.35em);
    filter: blur(8px);
  }
  :global(html.is-entered) .titlecard :global(.hero-wm .wm-l) {
    animation: letter-in 1.1s calc(0.25s + var(--i) * 0.06s) var(--ease-out) forwards;
  }
  :global(html.is-entered) .titlecard :global(.hero-wm .wm-o) {
    animation: atom-in 1.8s 0.1s var(--ease-out) forwards;
  }
  @keyframes letter-in {
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  @keyframes atom-in {
    0% {
      opacity: 0;
      transform: scale(0.2) rotate(-200deg);
      filter: blur(6px);
    }
    100% {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  .byline {
    font-size: clamp(0.95rem, 0.8rem + 0.6vw, 1.35rem);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    font-weight: 420;
    margin-right: -0.32em;
    color: rgb(237 232 222 / 0.9);
    opacity: 0;
  }
  :global(html.is-entered) .byline {
    animation: fade-in 1.4s 1.3s ease forwards;
  }

  /* Subtitle: the narrator speaks at the bottom of the frame */
  .subtitle {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 6cqh, 2.6rem);
    width: min(90%, 40rem);
    transform: translateX(-50%);
    text-align: center;
    font-size: clamp(1.05rem, 0.9rem + 0.7vw, 1.5rem);
    font-weight: 450;
    line-height: 1.35;
    color: #fff;
    text-shadow:
      0 0 2px rgb(0 0 0 / 0.9),
      0 2px 10px rgb(0 0 0 / 0.8);
    opacity: 0;
  }
  :global(html.is-entered) .subtitle {
    animation: fade-in 0.9s 2.2s ease forwards;
  }
  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }

  .slate {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--bar-bottom);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 0.75rem var(--gutter);
    flex-wrap: wrap;
    align-content: center;
    opacity: 0;
  }
  :global(html.is-entered) .slate {
    animation: fade-in 0.8s 2.4s ease forwards;
  }
  .now {
    min-width: 0;
  }
  .now-label {
    display: block;
    font-size: var(--step--1);
    color: var(--dust);
  }
  .slate-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .round {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    transition: border-color 0.2s;
  }
  .round:hover {
    border-color: var(--light);
  }
  .round svg {
    width: 0.7rem;
    height: 0.7rem;
  }
  .round .i-play,
  .round[aria-pressed='true'] .i-pause {
    display: none;
  }
  .round[aria-pressed='true'] .i-play {
    display: block;
  }
  .tc {
    color: var(--dust);
    min-width: 11ch;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: calc(var(--bar-bottom) / 2);
    transform: translate(-50%, 50%);
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--dust);
    text-decoration: none;
    opacity: 0;
  }
  :global(html.is-entered) .scroll-cue {
    animation: fade-in 0.8s 3s ease forwards;
  }
  .cue-line {
    width: 1px;
    height: 1.6rem;
    background: linear-gradient(var(--light), transparent);
    animation: cue 2s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0% { transform: scaleY(0); }
    50% { transform: scaleY(1); }
    100% { transform: scaleY(1); opacity: 0; }
  }

  @media (max-width: 899px) {
    .tc,
    .scroll-cue {
      display: none;
    }
    .slate {
      align-items: flex-end;
      padding-bottom: 1.1rem;
    }
    .byline {
      letter-spacing: 0.22em;
      margin-right: -0.22em;
    }
  }
  @media (max-width: 1100px) and (min-width: 900px) {
    .scroll-cue {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .weave,
    .leak {
      animation: none;
    }
  }
</style>

<script>
  import { getFilms, openFilm, timecode, loadYouTubeApi, prefersReducedMotion } from '../scripts/data';
  import { isSoundOn, onSound } from '../scripts/sound';

  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) {
    const all = getFilms();
    const reel = (hero.dataset.reel || '')
      .split(',')
      .map((slug) => all.find((f) => f.slug === slug))
      .filter(Boolean) as ReturnType<typeof getFilms>;

    const posters = [...hero.querySelectorAll<HTMLElement>('.poster')];
    const playerWraps = [...hero.querySelectorAll<HTMLElement>('.player')];
    const nowTitle = hero.querySelector<HTMLElement>('[data-now-title]')!;
    const nowYear = hero.querySelector<HTMLElement>('[data-now-year]')!;
    const watch = hero.querySelector<HTMLButtonElement>('[data-now-watch]')!;
    const toggle = hero.querySelector<HTMLButtonElement>('[data-reel-toggle]')!;
    const tcEl = hero.querySelector<HTMLElement>('[data-tc]')!;
    const flash = hero.querySelector<HTMLElement>('.flash')!;

    const HOLD = 7000;
    const VOLUME = 70;
    let index = 0;
    let paused = false;
    let visible = true;
    let timer: number | undefined;
    let clock = 0;
    let lastTick = performance.now();
    let mode: 'posters' | 'video' = 'posters';

    const cutFlash = () => {
      if (prefersReducedMotion()) return;
      flash.classList.remove('is-on');
      void flash.offsetWidth;
      flash.classList.add('is-on');
    };

    const show = (i: number) => {
      index = (i + reel.length) % reel.length;
      const f = reel[index];
      posters.forEach((p, n) => p.classList.toggle('is-on', n === index));
      nowTitle.textContent = f.title;
      if (f.language) nowTitle.setAttribute('lang', f.language);
      else nowTitle.removeAttribute('lang');
      nowYear.textContent = `, ${f.year}`;
      watch.dataset.slug = f.slug;
    };

    watch.addEventListener('click', () => openFilm(watch.dataset.slug!, watch));

    // Poster mode: slow crossfades on phones, with reduced motion, or before video is ready.
    const schedulePoster = () => {
      clearTimeout(timer);
      if (paused || !visible || mode !== 'posters' || prefersReducedMotion()) return;
      timer = window.setTimeout(() => {
        show(index + 1);
        clock = 0;
        schedulePoster();
      }, HOLD);
    };

    // Video mode: two players take turns, so every change is a clean cut.
    let players: any[] = [];
    let live = 0;
    const startFor = (f: (typeof reel)[number]) => Math.round(f.runtime * 0.3);

    // Volume ramps, so the sound of one film hands over to the next.
    const ramps = new Map<number, number>();
    const ramp = (slot: number, to: number, ms = 700, then?: () => void) => {
      const p = players[slot];
      if (!p?.setVolume) return;
      clearInterval(ramps.get(slot));
      let from = p.getVolume?.() ?? 0;
      if (p.isMuted?.()) from = 0;
      if (to > 0) {
        p.setVolume(from);
        p.unMute();
      }
      const steps = 14;
      let n = 0;
      const id = window.setInterval(() => {
        n++;
        p.setVolume(Math.round(from + ((to - from) * n) / steps));
        if (n >= steps) {
          clearInterval(id);
          if (to === 0) p.mute();
          then?.();
        }
      }, ms / steps);
      ramps.set(slot, id);
    };

    const cueOn = (slot: number, i: number) => {
      const f = reel[(i + reel.length) % reel.length];
      players[slot].__wanted = (i + reel.length) % reel.length;
      players[slot].mute();
      players[slot].loadVideoById({ videoId: f.videoId, startSeconds: startFor(f) });
    };

    const onPlaying = (slot: number) => {
      const p = players[slot];
      if (p.__wanted === undefined) return;
      const i = p.__wanted;
      p.__wanted = undefined;
      const previous = live;
      live = slot;
      playerWraps.forEach((w, n) => w.classList.toggle('is-on', n === slot));
      cutFlash();
      if (isSoundOn()) {
        ramp(slot, VOLUME, 900);
        if (previous !== slot) ramp(previous, 0, 900, () => players[previous]?.pauseVideo?.());
        else players[1 - slot]?.pauseVideo?.();
      } else {
        players[1 - slot]?.pauseVideo?.();
      }
      mode = 'video';
      clearTimeout(timer);
      show(i);
      scheduleVideo();
    };

    const scheduleVideo = () => {
      clearTimeout(timer);
      if (paused || !visible) return;
      timer = window.setTimeout(() => cueOn(1 - live, index + 1), HOLD);
    };

    const canPlayVideo =
      window.matchMedia('(min-width: 900px) and (pointer: fine)').matches &&
      !prefersReducedMotion() &&
      !(navigator as any).connection?.saveData &&
      reel.every((f) => f.platform === 'youtube');

    if (canPlayVideo) {
      loadYouTubeApi()
        .then((YT) => {
          let ready = 0;
          ['reel-a', 'reel-b'].forEach((id, slot) => {
            players[slot] = new YT.Player(id, {
              host: 'https://www.youtube-nocookie.com',
              playerVars: {
                autoplay: 0,
                controls: 0,
                disablekb: 1,
                fs: 0,
                iv_load_policy: 3,
                modestbranding: 1,
                playsinline: 1,
                rel: 0,
                mute: 1,
                origin: location.origin,
              },
              events: {
                onReady: (e: any) => {
                  e.target.mute();
                  e.target.getIframe().setAttribute('tabindex', '-1');
                  e.target.getIframe().setAttribute('title', 'Trailer');
                  if (++ready === 2) cueOn(0, index);
                },
                onStateChange: (e: any) => {
                  if (e.data === YT.PlayerState.PLAYING) onPlaying(slot);
                },
                onError: () => {
                  if (slot !== live || mode === 'posters') cueOn(slot, (players[slot].__wanted ?? index) + 1);
                },
              },
            });
          });
        })
        .catch(() => {
          /* stay in poster mode */
        });
    }

    onSound((on) => {
      if (mode !== 'video') return;
      if (on && !paused && visible) ramp(live, VOLUME, 900);
      else ramp(live, 0, 400);
    });

    const setPaused = (value: boolean) => {
      paused = value;
      toggle.setAttribute('aria-pressed', String(value));
      toggle.querySelector('.visually-hidden')!.textContent = value ? 'Play the trailer' : 'Pause the trailer';
      if (mode === 'video') {
        const p = players[live];
        if (paused || !visible) p?.pauseVideo?.();
        else {
          p?.playVideo?.();
          scheduleVideo();
        }
      } else schedulePoster();
      if (paused || !visible) clearTimeout(timer);
    };
    toggle.addEventListener('click', () => setPaused(!paused));

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting && !document.hidden;
      setPaused(paused);
    }).observe(hero);
    document.addEventListener('visibilitychange', () => {
      visible = !document.hidden;
      setPaused(paused);
    });

    // Step aside while a film plays in the theater.
    const inView = () => {
      const r = hero.getBoundingClientRect();
      return r.bottom > 0 && r.top < innerHeight && !document.hidden;
    };
    window.addEventListener('theater:open', () => {
      visible = false;
      setPaused(paused);
    });
    window.addEventListener('theater:close', () => {
      visible = inView();
      setPaused(paused);
    });

    const tick = (now: number) => {
      if (mode === 'video' && players[live]?.getCurrentTime) {
        tcEl.textContent = timecode(players[live].getCurrentTime());
      } else {
        if (!paused && visible) clock += (now - lastTick) / 1000;
        tcEl.textContent = timecode(clock);
      }
      lastTick = now;
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    show(0);
    schedulePoster();
  }
</script>
