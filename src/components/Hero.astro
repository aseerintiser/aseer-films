---
import Poster from './Poster.astro';
import { reel } from '../lib/films';
const first = reel[0];
---

<section class="hero" aria-labelledby="hero-title" data-reel={reel.map((f) => f.slug).join(',')}>
  <div class="frame">
    <div class="posters" aria-hidden="true">
      {
        reel.map((f, i) => (
          <Poster
            film={f}
            class={i === 0 ? 'poster is-on' : 'poster'}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
        ))
      }
    </div>
    <div class="players" aria-hidden="true">
      <div class="player"><div id="reel-a"></div></div>
      <div class="player"><div id="reel-b"></div></div>
    </div>
    <div class="shade" aria-hidden="true"></div>

    <div class="titlecard">
      <h1 id="hero-title">
        <span class="line"><span>Md Aseer</span></span>
        <span class="line"><span>Intiser</span></span>
      </h1>
      <p class="tagline">Every shot is a memory I don’t want to forget.</p>
      <p class="descriptor">Travel films, tributes and short stories, from Bangladesh to Finland.</p>
    </div>
  </div>

  <div class="slate">
    <p class="now" aria-live="polite">
      <span class="now-label">Now showing</span>
      <span class="now-title" data-now-title lang={first.language ?? undefined}>{first.title}</span><span class="now-year" data-now-year>, {first.year}</span>
    </p>
    <div class="slate-actions">
      <button class="btn" type="button" data-now-watch data-slug={first.slug}>
        <svg viewBox="0 0 10 12" aria-hidden="true"><path d="M0 0l10 6-10 6z" fill="currentColor"></path></svg>
        Watch this film
      </button>
      <button class="pause" type="button" data-reel-toggle aria-pressed="false">
        <span class="visually-hidden">Pause the reel</span>
        <svg class="i-pause" viewBox="0 0 10 12" aria-hidden="true"><path d="M1 0h3v12H1zM6 0h3v12H6z" fill="currentColor"></path></svg>
        <svg class="i-play" viewBox="0 0 10 12" aria-hidden="true"><path d="M0 0l10 6-10 6z" fill="currentColor"></path></svg>
      </button>
      <span class="tc" data-tc aria-hidden="true">00:00:00:00</span>
    </div>
  </div>
</section>

<style>
  .hero {
    --open-delay: 0.15s;
    --bar-top: 3.5rem;
    --bar-bottom: 7.5rem;
    position: relative;
    height: 100svh;
    min-height: 34rem;
    background: var(--black);
    overflow: hidden;
  }
  :global(html[data-intro]) .hero {
    --open-delay: 1.85s;
  }
  @media (min-width: 900px) {
    .hero {
      /* Letterbox the frame to 2.39:1 when the window is wide enough */
      --scope: max(3.5rem, calc((100svh - 100vw / 2.39) / 2));
      --bar-top: max(3.5rem, var(--scope));
      --bar-bottom: max(6.5rem, var(--scope));
    }
  }

  .frame {
    position: absolute;
    inset: var(--bar-top) 0 var(--bar-bottom);
    container-type: size;
    overflow: hidden;
    clip-path: inset(0 0 0 0);
    animation: shutter 1.1s var(--open-delay) var(--ease-film) both;
  }
  @keyframes shutter {
    from { clip-path: inset(50% 0 50% 0); }
    to { clip-path: inset(0 0 0 0); }
  }

  .posters :global(.poster) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 1.2s ease,
      transform 9s linear;
  }
  .posters :global(.poster.is-on) {
    opacity: 1;
    transform: scale(1);
  }

  .players {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .player {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100cqw, 177.78cqh);
    height: max(100cqh, 56.25cqw);
    transform: translate(-50%, -50%) scale(1.02);
    opacity: 0;
  }
  .player.is-on {
    opacity: 1;
  }
  .player :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0) 55%),
      linear-gradient(to right, rgb(0 0 0 / 0.45), rgb(0 0 0 / 0) 60%);
  }

  .titlecard {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(1.25rem, 6cqh, 3.5rem);
  }
  h1 {
    font-size: clamp(2.75rem, 1rem + 7.4vw, 9.5rem);
    font-weight: 460;
    line-height: 0.92;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    margin-left: -0.04em;
  }
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }
  .line > span {
    display: inline-block;
    animation: rise 1.1s calc(var(--open-delay) + 0.45s) var(--ease-out) both;
  }
  .line + .line > span {
    animation-delay: calc(var(--open-delay) + 0.58s);
  }
  @keyframes rise {
    from { transform: translateY(105%); }
    to { transform: none; }
  }
  .tagline {
    margin-top: 1.1rem;
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.35;
    font-weight: 360;
    color: rgb(237 232 222 / 0.88);
    animation: fade 1s calc(var(--open-delay) + 0.9s) ease both;
  }
  @keyframes fade {
    from { opacity: 0; }
  }
  .descriptor {
    margin-top: 0.6rem;
    color: var(--dust);
    font-size: var(--step-0);
    animation: fade 1s calc(var(--open-delay) + 1.05s) ease both;
  }

  .slate {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--bar-bottom);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 0.75rem var(--gutter);
    flex-wrap: wrap;
    align-content: center;
    animation: fade 0.8s calc(var(--open-delay) + 1.1s) ease both;
  }
  .now {
    min-width: 0;
    font-size: var(--step-0);
    color: var(--light);
  }
  .now-label {
    display: block;
    font-size: var(--step--1);
    color: var(--dust);
  }
  .slate-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .pause {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    transition: border-color 0.2s;
  }
  .pause:hover {
    border-color: var(--light);
  }
  .pause svg {
    width: 0.7rem;
    height: 0.7rem;
  }
  .pause .i-play,
  .pause[aria-pressed='true'] .i-pause {
    display: none;
  }
  .pause[aria-pressed='true'] .i-play {
    display: block;
  }
  .tc {
    color: var(--dust);
    min-width: 11ch;
  }
  @media (max-width: 899px) {
    .tc {
      display: none;
    }
    .slate {
      align-items: flex-end;
      padding-bottom: 1.1rem;
    }
  }
  @media (max-width: 520px) {
    .slate-actions .btn {
      padding-inline: 1rem;
    }
  }
</style>

<script>
  import { getFilms, openFilm, timecode, loadYouTubeApi, prefersReducedMotion } from '../scripts/data';

  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) {
    const all = getFilms();
    const reel = (hero.dataset.reel || '')
      .split(',')
      .map((slug) => all.find((f) => f.slug === slug))
      .filter(Boolean) as ReturnType<typeof getFilms>;

    const posters = [...hero.querySelectorAll<HTMLElement>('.poster')];
    const playerWraps = [...hero.querySelectorAll<HTMLElement>('.player')];
    const nowTitle = hero.querySelector<HTMLElement>('[data-now-title]')!;
    const nowYear = hero.querySelector<HTMLElement>('[data-now-year]')!;
    const watch = hero.querySelector<HTMLButtonElement>('[data-now-watch]')!;
    const toggle = hero.querySelector<HTMLButtonElement>('[data-reel-toggle]')!;
    const tcEl = hero.querySelector<HTMLElement>('[data-tc]')!;

    const HOLD = 7000;
    let index = 0;
    let paused = false;
    let visible = true;
    let timer: number | undefined;
    let clock = 0;
    let lastTick = performance.now();
    let mode: 'posters' | 'video' = 'posters';

    const show = (i: number) => {
      index = (i + reel.length) % reel.length;
      const f = reel[index];
      posters.forEach((p, n) => p.classList.toggle('is-on', n === index));
      nowTitle.textContent = f.title;
      if (f.language) nowTitle.setAttribute('lang', f.language);
      else nowTitle.removeAttribute('lang');
      nowYear.textContent = `, ${f.year}`;
      watch.dataset.slug = f.slug;
    };

    watch.addEventListener('click', () => openFilm(watch.dataset.slug!, watch));

    // Poster mode: slow crossfades. Used on phones, with reduced motion, or until video is ready.
    const schedulePoster = () => {
      clearTimeout(timer);
      if (paused || !visible || mode !== 'posters' || prefersReducedMotion()) return;
      timer = window.setTimeout(() => {
        show(index + 1);
        clock = 0;
        schedulePoster();
      }, HOLD);
    };

    // Video mode: two muted players take turns, so every change is a clean cut.
    let players: any[] = [];
    let live = 0;
    const startFor = (f: (typeof reel)[number]) => Math.round(f.runtime * 0.3);

    const cueOn = (slot: number, i: number) => {
      const f = reel[(i + reel.length) % reel.length];
      players[slot].__wanted = (i + reel.length) % reel.length;
      players[slot].loadVideoById({ videoId: f.videoId, startSeconds: startFor(f) });
    };

    const onPlaying = (slot: number) => {
      const p = players[slot];
      if (p.__wanted === undefined) return;
      const i = p.__wanted;
      p.__wanted = undefined;
      live = slot;
      playerWraps.forEach((w, n) => w.classList.toggle('is-on', n === slot));
      players[1 - slot]?.pauseVideo?.();
      mode = 'video';
      clearTimeout(timer);
      show(i);
      scheduleVideo();
    };

    const scheduleVideo = () => {
      clearTimeout(timer);
      if (paused || !visible) return;
      timer = window.setTimeout(() => cueOn(1 - live, index + 1), HOLD);
    };

    const canPlayVideo =
      window.matchMedia('(min-width: 900px) and (pointer: fine)').matches &&
      !prefersReducedMotion() &&
      !(navigator as any).connection?.saveData &&
      reel.every((f) => f.platform === 'youtube');

    if (canPlayVideo) {
      loadYouTubeApi()
        .then((YT) => {
          let ready = 0;
          ['reel-a', 'reel-b'].forEach((id, slot) => {
            players[slot] = new YT.Player(id, {
              host: 'https://www.youtube-nocookie.com',
              playerVars: {
                autoplay: 0,
                controls: 0,
                disablekb: 1,
                fs: 0,
                iv_load_policy: 3,
                modestbranding: 1,
                playsinline: 1,
                rel: 0,
                mute: 1,
                origin: location.origin,
              },
              events: {
                onReady: (e: any) => {
                  e.target.mute();
                  e.target.getIframe().setAttribute('tabindex', '-1');
                  e.target.getIframe().setAttribute('title', 'Background reel');
                  if (++ready === 2) cueOn(0, index);
                },
                onStateChange: (e: any) => {
                  if (e.data === YT.PlayerState.PLAYING) onPlaying(slot);
                },
                onError: () => {
                  // Skip a clip that refuses to embed.
                  if (slot !== live || mode === 'posters') cueOn(slot, (players[slot].__wanted ?? index) + 1);
                },
              },
            });
          });
        })
        .catch(() => {
          /* stay in poster mode */
        });
    }

    const setPaused = (value: boolean) => {
      paused = value;
      toggle.setAttribute('aria-pressed', String(value));
      toggle.querySelector('.visually-hidden')!.textContent = value ? 'Play the reel' : 'Pause the reel';
      if (mode === 'video') {
        const p = players[live];
        if (paused || !visible) p?.pauseVideo?.();
        else {
          p?.playVideo?.();
          scheduleVideo();
        }
      } else schedulePoster();
      if (paused || !visible) clearTimeout(timer);
    };
    toggle.addEventListener('click', () => setPaused(!paused));

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting && !document.hidden;
      setPaused(paused);
    }).observe(hero);
    document.addEventListener('visibilitychange', () => {
      visible = !document.hidden;
      setPaused(paused);
    });

    const tick = (now: number) => {
      if (mode === 'video' && players[live]?.getCurrentTime) {
        tcEl.textContent = timecode(players[live].getCurrentTime());
      } else {
        if (!paused && visible) clock += (now - lastTick) / 1000;
        tcEl.textContent = timecode(clock);
      }
      lastTick = now;
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    show(0);
    schedulePoster();
  }
</script>
