---
import Orbit from './Orbit.astro';
---

<div class="peep" role="dialog" aria-modal="true" aria-labelledby="peep-line" data-peep>
  <div class="peep-mask" aria-hidden="true"></div>
  <div class="peep-rim" aria-hidden="true"></div>
  <div class="peep-ui">
    <div class="peep-mark" aria-hidden="true"><Orbit spin /></div>
    <div class="peep-bottom">
      <p class="peep-line" id="peep-line">Look closer.</p>
      <div class="peep-actions">
        <button type="button" class="peep-btn is-primary" data-enter="sound">
          <svg viewBox="0 0 16 12" aria-hidden="true"><path d="M1 4h3l4-3v10L4 8H1zM11 3.5c1.2 1.4 1.2 3.6 0 5M13 1.5c2.2 2.6 2.2 6.4 0 9" fill="none" stroke="currentColor" stroke-width="1.3"></path></svg>
          Enter with sound
        </button>
        <button type="button" class="peep-btn" data-enter="silent">Enter without sound</button>
      </div>
      <p class="peep-hint">Headphones recommended</p>
    </div>
  </div>
</div>

<style is:global>
  @property --peep-r {
    syntax: '<length>';
    inherits: true;
    initial-value: 110px;
  }
  .peep {
    display: none;
  }
  html[data-intro] .peep {
    --peep-x: 50vw;
    --peep-y: 46vh;
    --peep-r: clamp(76px, 13vmin, 150px);
    position: fixed;
    inset: 0;
    z-index: 95;
    display: block;
    transition: --peep-r 1.35s cubic-bezier(0.7, 0, 0.2, 1);
  }
  html[data-intro] .peep.is-opening {
    --peep-r: 160vmax;
  }
  .peep-mask {
    position: absolute;
    inset: 0;
    background: #000;
    -webkit-mask: radial-gradient(
      circle var(--peep-r) at var(--peep-x) var(--peep-y),
      transparent calc(var(--peep-r) - 1px),
      #000 var(--peep-r)
    );
    mask: radial-gradient(
      circle var(--peep-r) at var(--peep-x) var(--peep-y),
      transparent calc(var(--peep-r) - 1px),
      #000 var(--peep-r)
    );
    cursor: pointer;
  }
  /* The rim of the lens: a soft inner shadow and a brass edge */
  .peep-rim {
    position: absolute;
    left: var(--peep-x);
    top: var(--peep-y);
    width: calc(var(--peep-r) * 2);
    height: calc(var(--peep-r) * 2);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow:
      inset 0 0 calc(var(--peep-r) * 0.45) calc(var(--peep-r) * 0.12) rgb(0 0 0 / 0.85),
      0 0 0 1px rgb(232 162 58 / 0.55),
      0 0 40px 4px rgb(232 162 58 / 0.18);
    pointer-events: none;
    transition: opacity 0.6s;
  }
  .peep.is-opening .peep-rim {
    opacity: 0;
  }
  .peep-ui {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: clamp(1.5rem, 5vh, 3rem) var(--gutter);
    pointer-events: none;
    transition: opacity 0.5s;
  }
  .peep.is-opening .peep-ui {
    opacity: 0;
  }
  .peep-mark {
    justify-self: center;
    font-size: 2.6rem;
    color: var(--light);
    opacity: 0;
    animation: peep-fade 1.2s 0.3s ease forwards;
  }
  .peep-bottom {
    grid-row: 3;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .peep-line {
    font-size: var(--step-2);
    font-weight: 400;
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.9);
    opacity: 0;
    animation: peep-fade 1.2s 0.6s ease forwards;
  }
  .peep-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    pointer-events: auto;
    opacity: 0;
    animation: peep-fade 1s 1.1s ease forwards;
  }
  .peep-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.4rem 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: 0.9375rem;
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .peep-btn svg {
    width: 1rem;
  }
  .peep-btn:hover,
  .peep-btn.is-primary {
    background: var(--light);
    border-color: var(--light);
    color: var(--black);
  }
  .peep-btn.is-primary:hover {
    background: var(--tungsten);
    border-color: var(--tungsten);
  }
  .peep-hint {
    font-size: var(--step--1);
    color: var(--dust);
    opacity: 0;
    animation: peep-fade 1s 1.4s ease forwards;
  }
  @keyframes peep-fade {
    to {
      opacity: 1;
    }
  }
</style>

<script>
  import { setSound, projector, click } from '../scripts/sound';

  const peep = document.querySelector<HTMLElement>('[data-peep]');
  const root = document.documentElement;

  if (peep && root.hasAttribute('data-intro')) {
    const blocked = [document.querySelector('main'), document.querySelector('header')].filter(Boolean) as HTMLElement[];
    blocked.forEach((el) => (el.inert = true));
    peep.querySelector<HTMLButtonElement>('.peep-btn')?.focus({ preventScroll: true });

    // The lens drifts after the pointer, with a little weight to it.
    let tx = innerWidth / 2;
    let ty = innerHeight * 0.46;
    let x = tx;
    let y = ty;
    let moved = false;
    let running = true;
    const fine = matchMedia('(pointer: fine)').matches;
    addEventListener('pointermove', (e) => {
      tx = e.clientX;
      ty = e.clientY;
      moved = true;
    });
    const t0 = performance.now();
    const loop = (now: number) => {
      if (!running) return;
      if (!fine || !moved) {
        // Idle: a slow figure-of-eight, like an eye searching the picture.
        const t = (now - t0) / 1000;
        tx = innerWidth / 2 + Math.sin(t * 0.5) * innerWidth * 0.06;
        ty = innerHeight * 0.46 + Math.sin(t * 1) * innerHeight * 0.04;
      }
      x += (tx - x) * 0.09;
      y += (ty - y) * 0.09;
      peep.style.setProperty('--peep-x', `${x}px`);
      peep.style.setProperty('--peep-y', `${y}px`);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);

    let entered = false;
    const enter = (withSound: boolean) => {
      if (entered) return;
      entered = true;
      setSound(withSound);
      if (withSound) {
        click(1);
        projector.start(0.14, 0.4);
        setTimeout(() => projector.stop(2.2), 1600);
      }
      peep.classList.add('is-opening');
      window.dispatchEvent(new CustomEvent('intro:enter', { detail: { sound: withSound } }));
      root.classList.add('is-entered');
      setTimeout(() => {
        running = false;
        root.removeAttribute('data-intro');
        blocked.forEach((el) => (el.inert = false));
        peep.remove();
        document.getElementById('main')?.focus({ preventScroll: true });
      }, 1400);
    };

    peep.querySelectorAll<HTMLButtonElement>('[data-enter]').forEach((b) =>
      b.addEventListener('click', () => enter(b.dataset.enter === 'sound')),
    );
    peep.querySelector('.peep-mask')!.addEventListener('click', () => enter(false));
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') enter(false);
    });
  } else {
    root.classList.add('is-entered');
    peep?.remove();
  }
</script>
