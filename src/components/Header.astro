---
import Wordmark from './Wordmark.astro';
const isHome = Astro.url.pathname === '/';
const base = isHome ? '' : '/';
---

<header class="bar">
  <a class="brand" href="/" aria-label="Bohrscope, home">
    <Wordmark class="brand-wm" />
  </a>
  <nav aria-label="Main">
    <a href={`${base}#selected`}>Films</a>
    <a href={`${base}#films`}>Archive</a>
    <a href={`${base}#credits`}>About</a>
    <button class="sound" type="button" data-sound-toggle aria-pressed="false">
      <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="sound-label">Sound</span>
    </button>
  </nav>
</header>

<style>
  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: var(--gutter);
    background: var(--black);
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
  }
  .brand {
    text-decoration: none;
    color: var(--light);
  }
  .brand :global(.brand-wm) {
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    gap: 0.16em;
  }
  .brand:hover :global(.orbit) {
    animation: orbit-spin 2.4s linear infinite;
  }
  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 3vw, 2.25rem);
  }
  nav a {
    color: var(--dust);
    text-decoration: none;
    transition: color 0.2s;
  }
  nav a:hover {
    color: var(--light);
  }
  .sound {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--dust);
    padding: 0.4rem 0;
  }
  .sound:hover,
  .sound[aria-pressed='true'] {
    color: var(--light);
  }
  .bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 0.8rem;
  }
  .bars i {
    width: 2px;
    height: 30%;
    background: currentColor;
    border-radius: 1px;
  }
  .sound[aria-pressed='true'] .bars i {
    animation: eq 0.9s ease-in-out infinite alternate;
  }
  .sound[aria-pressed='true'] .bars i:nth-child(2) {
    animation-delay: -0.3s;
  }
  .sound[aria-pressed='true'] .bars i:nth-child(3) {
    animation-delay: -0.6s;
  }
  .sound[aria-pressed='true'] .bars i:nth-child(4) {
    animation-delay: -0.15s;
  }
  @keyframes eq {
    from { height: 25%; }
    to { height: 100%; }
  }
  @media (max-width: 560px) {
    .brand :global(.brand-wm) {
      font-size: 0.9rem;
    }
    nav {
      gap: 0.85rem;
      font-size: 0.875rem;
    }
    .sound-label {
      display: none;
    }
  }
</style>

<script>
  import { isSoundOn, setSound, onSound, click } from '../scripts/sound';

  const btn = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
  if (btn) {
    const render = (on: boolean) => {
      btn.setAttribute('aria-pressed', String(on));
      btn.setAttribute('aria-label', on ? 'Sound is on. Turn sound off' : 'Sound is off. Turn sound on');
    };
    render(isSoundOn());
    onSound(render);
    btn.addEventListener('click', () => {
      setSound(!isSoundOn());
      click(0.6);
    });
  }
</script>
