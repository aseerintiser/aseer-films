---
import Poster from './Poster.astro';
import { chronological, films, firstYear, lastYear, filters, filterTags } from '../lib/films';

const widthFor = (runtime: number) => Math.round(120 + Math.sqrt(runtime) * 16);
const start = chronological.length - 1;
const current = chronological[start];
---

<section id="films" class="edit" aria-labelledby="films-title" style={`--accent:${current.accent}`}>
  <div class="intro">
    <h2 id="films-title">The archive</h2>
    <p>
      {films.length} films from {firstYear} to {lastYear}, laid out on a timeline the way I edit. Longer films make longer
      clips. Drag, swipe or use the arrows to scrub through.
    </p>
  </div>

  <div class="monitor-wrap">
    <div class="monitor">
      <div class="glow" aria-hidden="true"></div>
      <button class="screen" type="button" data-cursor="play" data-monitor-play aria-label={`Watch ${current.plainTitle}`}>
        {chronological.map((f, i) => <Poster film={f} class={i === start ? 'shot is-on' : 'shot'} alt="" deferred={i < start - 2} />)}
        <span class="play" aria-hidden="true">
          <svg viewBox="0 0 10 12"><path d="M0 0l10 6-10 6z" fill="currentColor"></path></svg>
        </span>
      </button>
    </div>

    <div class="info" aria-live="polite">
      <p class="kind" data-f="kindyear">{current.kind}, {current.year}</p>
      <h3 data-f="title" lang={current.language ?? undefined}>{current.title}</h3>
      <p class="subtitle" data-f="subtitle" hidden={!current.subtitle && !current.titleLatin}>
        {current.subtitle ?? current.titleLatin}
      </p>
      <p class="logline" data-f="logline" lang={current.loglineLang ?? undefined} hidden={!current.logline}>{current.logline}</p>
      <dl class="meta">
        <div>
          <dt>Runtime</dt>
          <dd class="tc" data-f="runtime">{current.runtimeLabel}</dd>
        </div>
        <div data-f="placewrap" hidden={!current.place}>
          <dt>Where</dt>
          <dd data-f="place">{current.place}</dd>
        </div>
        <div data-f="viewswrap" hidden={!current.viewsLabel}>
          <dt data-f="viewswhere">On {current.viewsWhere}</dt>
          <dd data-f="views">{current.viewsLabel}</dd>
        </div>
      </dl>
      <div class="actions">
        <button class="btn" type="button" data-watch data-slug={current.slug}>
          <svg viewBox="0 0 10 12" aria-hidden="true"><path d="M0 0l10 6-10 6z" fill="currentColor"></path></svg>
          Watch film
        </button>
        <a class="details" href={`/films/${current.slug}/`} data-f="link">Film page</a>
      </div>
    </div>
  </div>

  <div class="filters" role="group" aria-label="Show on the timeline">
    {
      filters.map((f, i) => (
        <button type="button" class="chip" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label}
          <span class="count">{f.count}</span>
        </button>
      ))
    }
  </div>

  <div class="timeline">
    <div class="tl-bar">
      <span class="track-name" aria-hidden="true">V1</span>
      <span class="tc" data-pos aria-hidden="true">{String(start + 1).padStart(2, '0')} / {String(chronological.length).padStart(2, '0')}</span>
      <div class="nudge">
        <button type="button" data-step="-1" aria-label="Previous film">
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M8 1L3 6l5 5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
        </button>
        <button type="button" data-step="1" aria-label="Next film">
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M4 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
        </button>
      </div>
    </div>

    <div class="viewport" data-viewport data-cursor="drag">
      <ol class="track" aria-label="Films, oldest to newest">
        {
          chronological.map((f, i) => {
            const newYear = i === 0 || chronological[i - 1].year !== f.year;
            return (
              <li class="slot" style={`--w:${widthFor(f.runtime)}px; --clip:${f.accent}`} data-year={newYear ? f.year : undefined} data-tags={filterTags(f)}>
                <button
                  class={i === start ? 'clip is-active' : 'clip'}
                  type="button"
                  data-index={i}
                  data-slug={f.slug}
                  tabindex={i === start ? 0 : -1}
                  aria-label={`${f.plainTitle}, ${f.year}, ${f.runtimeLabel}`}
                >
                  <span class="strip" style={f.posterSmall ? `background-image:url(${f.posterSmall})` : undefined}>
                    {!f.posterSmall && <span class="strip-name" lang={f.language ?? undefined}>{f.title}</span>}
                  </span>
                  <span class="clip-label">
                    <span class="clip-title" lang={f.language ?? undefined}>{f.title}</span>
                    <span class="tc">{f.runtimeLabel}</span>
                  </span>
                </button>
              </li>
            );
          })
        }
        <li class="slot next-slot" aria-hidden="true" style="--w:200px">
          <span class="strip ghost">Next film</span>
        </li>
      </ol>
    </div>
    <div class="playhead" aria-hidden="true"></div>
  </div>
</section>

<style>
  .edit {
    position: relative;
    padding: clamp(5rem, 12vw, 9rem) 0 clamp(4rem, 8vw, 6rem);
  }
  .intro {
    padding-inline: var(--gutter);
    display: grid;
    gap: 1rem;
    max-width: 72rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  h2 {
    font-size: var(--step-5);
    font-weight: 430;
    letter-spacing: -0.01em;
  }
  .intro p {
    max-width: 50ch;
    color: var(--dust);
    font-size: var(--step-1);
    line-height: 1.4;
    font-weight: 340;
  }

  .monitor-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(16rem, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    padding-inline: var(--gutter);
  }
  .monitor {
    position: relative;
  }
  .glow {
    position: absolute;
    inset: 6% 4%;
    background: var(--accent);
    filter: blur(80px);
    opacity: 0.3;
    transition: background-color 0.8s ease;
    pointer-events: none;
  }
  .screen {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--screen) center / cover no-repeat;
    cursor: pointer;
  }
  .screen :global(.shot) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.18s linear;
  }
  .screen :global(.shot.is-on) {
    opacity: 1;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.45);
    border: 1px solid rgb(237 232 222 / 0.5);
    backdrop-filter: blur(6px);
    transform: translate(-50%, -50%) scale(0.9);
    opacity: 0;
    transition:
      opacity 0.3s,
      transform 0.4s var(--ease-out);
  }
  .play svg {
    width: 1.1rem;
    margin-left: 0.2rem;
  }
  .screen:hover .play,
  .screen:focus-visible .play {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  @media (hover: none) {
    .play {
      opacity: 1;
      transform: translate(-50%, -50%) scale(0.8);
    }
  }

  .info {
    display: grid;
    gap: 0.9rem;
    align-content: end;
    min-height: 100%;
    padding-bottom: 0.25rem;
  }
  .kind {
    color: var(--accent);
    font-weight: 450;
    transition: color 0.6s;
  }
  h3 {
    font-size: var(--step-4);
    font-weight: 440;
  }
  .subtitle {
    color: var(--dust);
    margin-top: -0.4rem;
  }
  .logline {
    max-width: 38ch;
    font-size: var(--step-1);
    line-height: 1.4;
    font-weight: 340;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 0.4rem 0 0.6rem;
  }
  .meta dt {
    font-size: var(--step--1);
    color: var(--dust);
  }
  .meta dd {
    margin: 0;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .details {
    color: var(--dust);
    font-size: 0.9375rem;
  }
  .details:hover {
    color: var(--light);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-inline: var(--gutter);
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--dust);
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }
  .chip:hover {
    color: var(--light);
    border-color: var(--rule-strong);
  }
  .chip[aria-pressed='true'] {
    background: var(--light);
    border-color: var(--light);
    color: var(--black);
  }
  @media (max-width: 640px) {
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 0.25rem;
    }
    .filters::-webkit-scrollbar {
      display: none;
    }
    .chip {
      flex: none;
    }
  }
  .count {
    font-family: var(--font-tc);
    font-size: 0.6875rem;
    opacity: 0.7;
  }

  /* Timeline */
  .timeline {
    position: relative;
    margin-top: 1.25rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: linear-gradient(var(--screen), var(--screen)) 0 2.75rem / 100% calc(100% - 2.75rem) no-repeat;
  }
  .tl-bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 2.75rem;
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--rule);
    color: var(--dust);
  }
  .track-name {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--light);
  }
  .nudge {
    margin-left: auto;
    display: flex;
    gap: 0.25rem;
  }
  .nudge button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--dust);
    transition: color 0.2s;
  }
  .nudge button:hover {
    color: var(--light);
  }
  .nudge svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  .viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
    padding: 2.4rem 0 1.4rem;
    /* Ruler: light ticks every 24px, heavier ones every 120px */
    background:
      repeating-linear-gradient(to right, var(--rule-strong) 0 1px, transparent 1px 120px) 0 0 / 100% 0.7rem no-repeat,
      repeating-linear-gradient(to right, var(--rule) 0 1px, transparent 1px 24px) 0 0 / 100% 0.4rem no-repeat;
    background-attachment: local;
  }
  .viewport::-webkit-scrollbar {
    display: none;
  }
  .viewport.dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }
  .viewport.dragging .clip {
    pointer-events: none;
  }
  .track {
    display: flex;
    gap: 3px;
    width: max-content;
    margin: 0;
    padding: 0 50vw;
    list-style: none;
  }
  .slot {
    position: relative;
    width: var(--w);
    flex: none;
    scroll-snap-align: center;
    transition: opacity 0.3s;
  }
  .slot.is-dim {
    opacity: 0.18;
    scroll-snap-align: none;
  }
  .slot[data-year]::before {
    content: attr(data-year);
    position: absolute;
    top: -1.8rem;
    left: 0;
    font-family: var(--font-tc);
    font-size: 0.75rem;
    color: var(--dust);
    padding-left: 0.4rem;
    border-left: 1px solid var(--rule-strong);
    line-height: 1.1rem;
  }
  .clip {
    display: block;
    width: 100%;
    text-align: left;
    opacity: 0.55;
    transition: opacity 0.25s;
  }
  .clip:hover,
  .clip.is-active {
    opacity: 1;
  }
  .strip {
    display: flex;
    align-items: center;
    padding-inline: 0.6rem;
    overflow: hidden;
    height: clamp(3.5rem, 7vw, 5rem);
    background-color: color-mix(in oklab, var(--clip) 34%, var(--black));
    background-repeat: repeat-x;
    background-size: auto 100%;
    border-top: 3px solid var(--clip);
    border-radius: 2px;
  }
  .next-slot {
    scroll-snap-align: none;
    margin-left: 1.5rem;
  }
  .ghost {
    justify-content: center;
    border: 1px dashed var(--rule-strong);
    background: none;
    color: var(--dust);
    font-size: 0.8125rem;
  }
  .strip-name {
    font-size: 0.75rem;
    white-space: nowrap;
    opacity: 0.8;
  }
  .clip.is-active .strip {
    box-shadow: 0 0 0 1px var(--light);
  }
  .clip-label {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.55rem;
    font-size: 0.875rem;
    line-height: 1.3;
  }
  .clip-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .clip-label .tc {
    color: var(--dust);
    font-size: 0.75rem;
  }
  .playhead {
    position: absolute;
    top: 2.75rem;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--tungsten);
    pointer-events: none;
    box-shadow: 0 0 12px rgb(232 162 58 / 0.6);
  }
  .playhead::before {
    content: '';
    position: absolute;
    top: 0;
    left: -6px;
    border: 6px solid transparent;
    border-top: 8px solid var(--tungsten);
  }

  @media (max-width: 860px) {
    .monitor-wrap {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { getFilms, openFilm } from '../scripts/data';

  const section = document.querySelector<HTMLElement>('.edit');
  if (section) {
    const byslug = new Map(getFilms().map((f) => [f.slug, f]));
    const viewport = section.querySelector<HTMLElement>('[data-viewport]')!;
    const clips = [...section.querySelectorAll<HTMLButtonElement>('.clip')];
    const slots = clips.map((c) => c.parentElement as HTMLElement);
    const shots = [...section.querySelectorAll<HTMLElement>('.shot')];
    const screen = section.querySelector<HTMLButtonElement>('[data-monitor-play]')!;
    const watch = section.querySelector<HTMLButtonElement>('[data-watch]')!;
    const pos = section.querySelector<HTMLElement>('[data-pos]')!;
    const chips = [...section.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const field = (name: string) => section.querySelector<HTMLElement>(`[data-f="${name}"]`)!;
    const pad = (n: number) => String(n).padStart(2, '0');
    const setLang = (el: HTMLElement, lang: string | null) =>
      lang ? el.setAttribute('lang', lang) : el.removeAttribute('lang');

    let active = clips.findIndex((c) => c.classList.contains('is-active'));
    let visible = clips.map((_, i) => i);

    const setActive = (i: number) => {
      if (i === active || i < 0 || i >= clips.length) return;
      active = i;
      const f = byslug.get(clips[i].dataset.slug!)!;
      clips.forEach((c, n) => {
        c.classList.toggle('is-active', n === i);
        c.tabIndex = n === i ? 0 : -1;
      });
      shots.forEach((s, n) => s.classList.toggle('is-on', n === i));
      // Load the big still for this film and its neighbours only when needed.
      for (let k = i - 2; k <= i + 2; k++) {
        const img = shots[k] as HTMLImageElement | undefined;
        if (img?.dataset.src && !img.getAttribute('src')) img.src = img.dataset.src;
      }
      screen.style.backgroundImage = f.posterSmall ? `url(${f.posterSmall})` : '';
      section.style.setProperty('--accent', f.accent);
      field('kindyear').textContent = `${f.kind}, ${f.year}`;
      field('title').textContent = f.title;
      setLang(field('title'), f.language);
      const sub = f.subtitle ?? f.titleLatin;
      field('subtitle').textContent = sub ?? '';
      field('subtitle').hidden = !sub;
      field('logline').textContent = f.logline;
      setLang(field('logline'), f.loglineLang);
      field('logline').hidden = !f.logline;
      field('runtime').textContent = f.runtimeLabel;
      field('place').textContent = f.place ?? '';
      field('placewrap').hidden = !f.place;
      field('views').textContent = f.viewsLabel ?? '';
      field('viewswhere').textContent = `On ${f.viewsWhere}`;
      field('viewswrap').hidden = !f.viewsLabel;
      (field('link') as HTMLAnchorElement).href = `/films/${f.slug}/`;
      watch.dataset.slug = f.slug;
      screen.setAttribute('aria-label', `Watch ${f.titleLatin ?? f.title}`);
      const order = visible.indexOf(i);
      pos.textContent = `${pad(order + 1)} / ${pad(visible.length)}`;
    };

    const centerOf = (i: number) => slots[i].offsetLeft + slots[i].offsetWidth / 2 - viewport.clientWidth / 2;
    const scrollToClip = (i: number, smooth = true) => {
      viewport.scrollTo({ left: centerOf(i), behavior: smooth ? 'smooth' : 'instant' });
      setActive(i);
    };
    const step = (dir: number) => {
      const order = visible.indexOf(active);
      const next = visible[Math.max(0, Math.min(visible.length - 1, (order < 0 ? 0 : order) + dir))];
      if (next !== undefined) scrollToClip(next);
      return next;
    };

    // Whatever sits under the playhead is on the monitor, live while scrubbing.
    let raf = 0;
    viewport.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const mid = viewport.scrollLeft + viewport.clientWidth / 2;
          let best = active;
          let dist = Infinity;
          for (const n of visible) {
            const d = Math.abs(slots[n].offsetLeft + slots[n].offsetWidth / 2 - mid);
            if (d < dist) {
              dist = d;
              best = n;
            }
          }
          setActive(best);
        });
      },
      { passive: true },
    );

    clips.forEach((c, n) => {
      c.addEventListener('click', () => {
        if (n === active) openFilm(c.dataset.slug!, c);
        else scrollToClip(n);
      });
      c.addEventListener('keydown', (e) => {
        let next: number | undefined;
        if (e.key === 'ArrowRight') next = step(1);
        else if (e.key === 'ArrowLeft') next = step(-1);
        else if (e.key === 'Home') scrollToClip((next = visible[0]));
        else if (e.key === 'End') scrollToClip((next = visible[visible.length - 1]));
        else return;
        e.preventDefault();
        if (next !== undefined) clips[next].focus({ preventScroll: true });
      });
    });

    section.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => step(Number(b.dataset.step))),
    );
    watch.addEventListener('click', () => openFilm(watch.dataset.slug!, watch));
    screen.addEventListener('click', () => openFilm(watch.dataset.slug!, screen));

    // Filters dim the clips that do not match, and the playhead skips them.
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const id = chip.dataset.filter!;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        visible = [];
        slots.forEach((s, n) => {
          const match = (s.dataset.tags || '').split(' ').includes(id);
          s.classList.toggle('is-dim', !match);
          clips[n].disabled = !match;
          if (match) visible.push(n);
        });
        if (!visible.includes(active)) {
          // Jump to the newest film that matches.
          const target = visible[visible.length - 1];
          active = -1;
          if (target !== undefined) scrollToClip(target);
        } else {
          const keep = active;
          active = -1;
          setActive(keep);
        }
      }),
    );

    // Mouse drag to scrub. Touch and trackpads already scroll natively.
    viewport.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      const x0 = e.clientX;
      const left0 = viewport.scrollLeft;
      let dragging = false;
      const move = (ev: PointerEvent) => {
        const dx = ev.clientX - x0;
        if (!dragging && Math.abs(dx) > 4) {
          dragging = true;
          viewport.classList.add('dragging');
        }
        if (dragging) viewport.scrollLeft = left0 - dx;
      };
      const up = () => {
        window.removeEventListener('pointermove', move);
        window.removeEventListener('pointerup', up);
        if (dragging) {
          // Let the click that ends a drag land on nothing.
          requestAnimationFrame(() => viewport.classList.remove('dragging'));
          scrollToClip(active);
        }
      };
      window.addEventListener('pointermove', move);
      window.addEventListener('pointerup', up);
    });

    // Start on the newest film without animating.
    requestAnimationFrame(() => {
      viewport.scrollLeft = centerOf(active);
    });
  }
</script>
