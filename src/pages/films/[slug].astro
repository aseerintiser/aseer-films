---
import Base from '../../layouts/Base.astro';
import Poster from '../../components/Poster.astro';
import { films, site, type Film } from '../../lib/films';

export function getStaticPaths() {
  return films.map((film, i) => ({
    params: { slug: film.slug },
    props: { film, newer: films[i - 1] ?? null, older: films[i + 1] ?? null },
  }));
}

interface Props {
  film: Film;
  newer: Film | null;
  older: Film | null;
}

const { film, newer, older } = Astro.props;
const description = film.logline || `${film.kind} by ${site.name}, ${film.year}.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: film.plainTitle,
  description,
  thumbnailUrl: film.posterLarge ? new URL(film.posterLarge, Astro.site).href : undefined,
  uploadDate: film.date.length > 4 ? film.date : undefined,
  duration: `PT${Math.floor(film.runtime / 60)}M${film.runtime % 60}S`,
  embedUrl: film.embed,
  creator: { '@type': 'Person', name: site.name },
};
const facts: [string, string, string?][] = [['Runtime', film.runtimeLabel]];
if (film.place) facts.push(['Where', film.place]);
if (film.viewsLabel) facts.push([`On ${film.viewsWhere}`, film.viewsLabel, 'views']);
(film.credits ?? []).forEach((c) => facts.push([c.role, c.name]));
---

<Base
  title={film.plainTitle}
  description={description}
  image={film.posterLarge ? new URL(film.posterLarge, Astro.site).href : undefined}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="film-page" style={`--accent:${film.accent}`}>
    <div class="ambient" aria-hidden="true" style={film.posterSmall ? `background-image:url(${film.posterSmall})` : undefined}></div>
    <div class="wrap">
      <p class="kind"><a href="/#films">Every film</a><span aria-hidden="true">/</span>{film.kind}, {film.year}</p>

      <div class="player" data-embed={film.embed} data-platform={film.platform}>
        <button class="start" type="button" aria-label={`Play ${film.plainTitle}`}>
          <Poster film={film} class="still" loading="eager" fetchpriority="high" />
          <span class="play" aria-hidden="true">
            <svg viewBox="0 0 10 12"><path d="M0 0l10 6-10 6z" fill="currentColor"></path></svg>
          </span>
        </button>
      </div>

      <div class="info">
        <div>
          <h1 lang={film.language ?? undefined}>{film.title}</h1>
          {(film.subtitle || film.titleLatin) && <p class="sub">{film.subtitle ?? film.titleLatin}</p>}
          {film.logline && <p class="logline" lang={film.loglineLang ?? undefined}>{film.logline}</p>}
          {film.notes && <p class="notes" lang={film.notesLang ?? undefined}>{film.notes}</p>}
        </div>
        <div>
          <dl class="facts">
            {
              facts.map(([dt, dd, cls]) => (
                <div>
                  <dt>{dt}</dt>
                  <dd class={cls}>{dd}</dd>
                </div>
              ))
            }
          </dl>
          <p class="links">
            {film.youtubeUrl && <a href={film.youtubeUrl} target="_blank" rel="noopener">Watch on YouTube</a>}
            {film.facebookUrl && (
              <a href={film.facebookUrl} target="_blank" rel="noopener">
                {film.youtubeUrl ? 'Also on Facebook' : 'Watch on Facebook'}
              </a>
            )}
          </p>
        </div>
      </div>

      <nav class="more" aria-label="More films">
        {newer ? (
          <a href={`/films/${newer.slug}/`}><span class="dir">Newer</span><span lang={newer.language ?? undefined}>{newer.title}</span></a>
        ) : <span />}
        {older ? (
          <a href={`/films/${older.slug}/`}><span class="dir">Older</span><span lang={older.language ?? undefined}>{older.title}</span></a>
        ) : <span />}
      </nav>
    </div>
  </article>
</Base>

<style>
  .film-page {
    position: relative;
    min-height: 100svh;
    padding: 3.5rem 0 4rem;
    overflow: hidden;
  }
  .ambient {
    position: absolute;
    inset: -10% -10% auto;
    height: 90vh;
    background: center / cover no-repeat;
    filter: blur(90px) saturate(1.3);
    opacity: 0.3;
    pointer-events: none;
  }
  .wrap {
    position: relative;
    width: min(100% - 2 * var(--gutter), (100svh - 9rem) * 16 / 9, 1600px);
    margin: 0 auto;
  }
  .kind {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    height: 4.25rem;
    color: var(--dust);
    font-size: 0.9375rem;
  }
  .kind a {
    color: var(--light);
    text-decoration: none;
  }
  .kind a:hover {
    color: var(--accent);
  }
  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #050505;
    box-shadow: 0 30px 120px -20px color-mix(in oklab, var(--accent) 45%, transparent);
  }
  .player :global(iframe),
  .start {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .start :global(.still) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.45);
    border: 1px solid rgb(237 232 222 / 0.6);
    backdrop-filter: blur(6px);
    transform: translate(-50%, -50%);
    transition: transform 0.4s var(--ease-out);
  }
  .play svg {
    width: 1.2rem;
    margin-left: 0.2rem;
  }
  .start:hover .play {
    transform: translate(-50%, -50%) scale(1.08);
  }
  .info {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(14rem, 1fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }
  h1 {
    font-size: var(--step-5);
    font-weight: 440;
  }
  .sub {
    margin-top: 0.5rem;
    color: var(--dust);
  }
  .logline {
    margin-top: 1.4rem;
    font-size: var(--step-1);
    line-height: 1.4;
    font-weight: 340;
    max-width: 40ch;
  }
  .notes {
    margin-top: 1rem;
    max-width: 60ch;
    color: rgb(237 232 222 / 0.78);
    font-weight: 340;
  }
  .facts {
    display: grid;
    gap: 0.9rem;
    margin: 0.6rem 0 0;
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--dust);
  }
  .facts dd {
    margin: 0;
  }
  .facts .views {
    color: var(--accent);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    font-size: 0.9375rem;
  }
  .links a {
    color: var(--dust);
  }
  .links a:hover {
    color: var(--light);
  }
  .more {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid var(--rule);
  }
  .more a {
    display: grid;
    gap: 0.3rem;
    padding: 1.4rem 0;
    text-decoration: none;
    font-size: var(--step-1);
    line-height: 1.25;
  }
  .more a:last-child {
    text-align: right;
  }
  .more a:hover span:last-child {
    color: var(--accent);
  }
  .dir {
    font-size: var(--step--1);
    color: var(--dust);
  }
  @media (max-width: 760px) {
    .wrap {
      width: calc(100% - 2 * var(--gutter));
    }
    .info {
      grid-template-columns: 1fr;
    }
    .more a {
      font-size: var(--step-0);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.film-page .player').forEach((player) => {
    const button = player.querySelector('.start')!;
    button.addEventListener('click', () => {
      let src = player.dataset.embed!;
      if (player.dataset.platform === 'facebook') {
        const w = Math.round(player.clientWidth);
        src += `&width=${w}&height=${Math.round((w * 9) / 16)}`;
      }
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = 'Video player';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen; clipboard-write; web-share';
      iframe.allowFullscreen = true;
      player.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
