---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Theater from '../components/Theater.astro';
import { films, clientFilm, site } from '../lib/films';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  intro?: boolean;
}

const { title, description = site.description, image, intro = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name}, films`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ?? films.find((f) => f.slug === 'rangamati-story')?.posterLarge;
const payload = JSON.stringify(films.map(clientFilm));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://i.ytimg.com" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    {
      intro && (
        <script is:inline>
          try {
            if (
              !sessionStorage.getItem('leader') &&
              !matchMedia('(prefers-reduced-motion: reduce)').matches
            ) {
              document.documentElement.setAttribute('data-intro', '');
              sessionStorage.setItem('leader', '1');
            }
          } catch (e) {}
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      intro && (
        <div class="leader" aria-hidden="true">
          <div class="leader-ring">
            <span>3</span>
            <span>2</span>
            <span>1</span>
          </div>
        </div>
      )
    }
    <Header />
    <main id="main">
      <slot />
    </main>
    <Theater />
    <div class="grain" aria-hidden="true"></div>
    <script id="film-data" type="application/json" set:html={payload} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style is:global>
  .leader {
    display: none;
  }
  html[data-intro] .leader {
    position: fixed;
    inset: 0;
    z-index: 95;
    display: grid;
    place-items: center;
    background: var(--black);
    animation: leader-out 0.35s 1.65s var(--ease-film) forwards;
  }
  .leader-ring {
    position: relative;
    width: min(46vmin, 320px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid var(--rule-strong);
    display: grid;
    place-items: center;
    background: conic-gradient(rgb(237 232 222 / 0.12) var(--sweep), transparent 0);
    animation: sweep 0.55s linear 3;
  }
  .leader-ring::before,
  .leader-ring::after {
    content: '';
    position: absolute;
    background: var(--rule);
  }
  .leader-ring::before {
    inset: 50% -30vmax auto;
    height: 1px;
  }
  .leader-ring::after {
    inset: -30vmax auto auto 50%;
    width: 1px;
    height: calc(100% + 60vmax);
  }
  .leader-ring span {
    grid-area: 1 / 1;
    font-size: clamp(5rem, 22vmin, 11rem);
    font-weight: 400;
    line-height: 1;
    opacity: 0;
    animation: count 0.55s steps(1) forwards;
  }
  .leader-ring span:nth-child(2) {
    animation-delay: 0.55s;
  }
  .leader-ring span:nth-child(3) {
    animation-delay: 1.1s;
  }
  @property --sweep {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes sweep {
    from { --sweep: 0deg; }
    to { --sweep: 360deg; }
  }
  @keyframes count {
    0% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes leader-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
