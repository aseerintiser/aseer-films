---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Theater from '../components/Theater.astro';
import Intro from '../components/Intro.astro';
import Cursor from '../components/Cursor.astro';
import { films, clientFilm, site } from '../lib/films';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  intro?: boolean;
}

const { title, description = site.description, image, intro = false } = Astro.props;
const pageTitle = title ? `${title} | Bohrscope` : `Bohrscope | Films by ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ?? films.find((f) => f.slug === 'rangamati-story')?.posterLarge;
const payload = JSON.stringify(films.map(clientFilm));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://i.ytimg.com" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bohrscope" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    {
      intro && (
        <script is:inline>
          // The peephole greets every new visit and every reload. It stays out of the way
          // when someone is already moving around the site, jumps to a section, or prefers less motion.
          try {
            var nav = performance.getEntriesByType('navigation')[0];
            var type = nav ? nav.type : 'navigate';
            var fromSite = false;
            if (document.referrer) fromSite = new URL(document.referrer).origin === location.origin;
            var show =
              !matchMedia('(prefers-reduced-motion: reduce)').matches &&
              !location.hash &&
              type !== 'back_forward' &&
              (type === 'reload' || !fromSite);
            if (show) document.documentElement.setAttribute('data-intro', '');
          } catch (e) {}
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Intro />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Theater />
    <div class="grain" aria-hidden="true"></div>
    <Cursor />
    <script id="film-data" type="application/json" set:html={payload} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
